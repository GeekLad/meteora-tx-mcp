# meteora-tx-mcp configuration. Copy to .env and fill in values.
# Every variable is optional; the defaults are shown in comments.

# Solana JSON-RPC HTTP URL. Mainnet. Each tool call also accepts an rpcUrl
# argument that overrides this.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Streamable-HTTP MCP listener. Runs beside the stdio transport.
# Enabled by default on 127.0.0.1:5150 with the endpoint /mcp.
MCP_HTTP_ENABLED=true
MCP_HTTP_PORT=5150
# Bind interface. 127.0.0.1 (default) only accepts loopback Host headers;
# 0.0.0.0 or :: binds every interface and is intended for local networks.
MCP_HTTP_HOST=127.0.0.1